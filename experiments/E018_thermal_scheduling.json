{
 "key": "E018",
 "kind": "facility",
 "title": "Thermal-credit scheduling vs round-robin, least-loaded, power-aware and temperature-aware placement",
 "research_question": "Under equal hardware protection (thermal throttle, rack power caps) and equal cooling, does placing jobs by thermal capacity budgets (and lowering clocks or holding jobs when no placement stays within budget) improve completed on-time work, facility energy per on-time job and thermal safety, and when does it give no benefit?",
 "hypothesis": "32 GPUs (2 racks x 2 nodes x 8), 2 h arrivals + 30 min drain, NTU plant, 5 conditions: C1 uniform cooling (parallel plates, equal hydraulics), load 0.5, supply 30 C; C2 series pairs, farthest node 2x branch resistance, load 0.85, supply 35 C; C3 as C2 with supply 40 C; C4 series pairs, spread 0.5, rack IT limit 7 kW, load 0.6 with two 15-min bursts (+0.4); C5 heterogeneous nodes (type A and type B: 1.4x dynamic power, 1.3x conduction resistance, 1.3x speed, 141 GB), series pairs, spread 0.5, load 0.8, supply 35 C. Paired by seed (identical job streams). H1: in C2, C3 and C5, thermal_credit's facility energy per on-time job is lower than each of the four baselines (round_robin, least_loaded, power_aware, temperature_aware) with the 95% CI of the paired relative difference below 0 and the mean at most -2%. H2: in every condition, thermal_credit's chip-seconds above t_target are at most temperature_aware's (seed means), and in C2, C3 and C5 at most half of least_loaded's. H3: in C2, C3 and C5, thermal_credit's on-time fraction is no more than 2 percentage points below the best baseline's (seed means). H4 (expected null): in C1, thermal_credit and least_loaded differ by less than 1% in energy per on-time job and by less than 1 percentage point in on-time fraction. H5: in C4, thermal_credit's on-time fraction is at least power_aware's (seed means). Descriptive: thermal_placement (placement rule only, full clock, never holds) separates the placement effect from the clock/admission effect; admission decision counts; throttle GPU-seconds; cap steps; waits.",
 "null_hypothesis": "Thermal-credit scheduling performs no better than the baselines in energy, service or safety.",
 "independent_variables": [
  "scheduler (6)",
  "condition (5)"
 ],
 "dependent_variables": [
  "E_per_on_time_job_kJ",
  "on_time_frac",
  "jobs_on_time",
  "work_done_gpu_s",
  "E_grid_kWh",
  "chip_s_over_target",
  "throttle_gpu_s",
  "cap_steps",
  "mean_wait_s",
  "p95_wait_s",
  "T_max_C"
 ],
 "controlled_variables": [
  "identical job streams per seed",
  "EDF queue order with backfilling for every scheduler",
  "same hardware throttle and power caps",
  "same plant and supply",
  "dt 2 s"
 ],
