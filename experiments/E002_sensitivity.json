{
  "key": "E002",
  "title": "One-at-a-time sensitivity of policy comparisons to uncertain assumptions",
  "research_question": "Which uncertain (class E/F) assumptions materially change the conclusions of E001 for joint vs independent and joint vs fixed?",
  "hypothesis": "The sign of (joint - independent) energy per successful task is non-positive for every one-at-a-time variation; its magnitude is most sensitive to the leakage parameters (kappa_leak, p_leak_ref). The joint-vs-fixed saving is most sensitive to the V-f curve (v_min_ratio) and memory-boundness (beta_memory).",
  "null_hypothesis": "Some variation reverses the sign of joint - independent, or other parameters dominate.",
  "independent_variables": [
    "one parameter at its low or high bound (25 parameters x 2)",
    "policy (3 levels)"
  ],
  "dependent_variables": [
    "E_per_success_kJ",
    "chip_s_throttled",
    "slo_violations"
  ],
  "controlled_variables": [
    "scenario S1_moderate shortened to a 2 h arrival window (one load cycle)",
    "all other parameters at defaults",
    "seeds 0-2"
  ],
  "baseline": "default variant; fixed policy within each variant",
  "configuration": "As E001, S1 scenario, 2 h",
  "evaluation_criteria": "For each variant: paired relative difference joint vs independent and joint vs fixed with 95% CI (n=3 seeds, so CIs are wide; used for ranking, not confirmation). Rank parameters by the swing (high minus low) of the mean difference.",
  "known_limitations": "One-at-a-time design misses interactions; only 3 seeds per cell; ranges are judgement calls recorded in the registry.",
